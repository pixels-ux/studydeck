# Copy to .env if you want to configure the AI desk from the environment.
# Everything here is optional: keys can also be added inside the app, and the
# rest of Studydeck needs no configuration at all.

# Where your data lives, and where the app listens.
# DATABASE_PATH=data/studydeck.db
# PORT=3000
# HOST=0.0.0.0

# AI study desk: pick one provider (40 actions per day).
# With no AI_PROVIDER, the first key set wins: OpenRouter, Groq, Gemini,
# DeepSeek, Mistral, Together, then Freebuff. Ollama is only used when named.
# AI_PROVIDER=openrouter | gemini | groq | openai | mistral | deepseek |
#             together | freebuff | custom | ollama
# AI_MODEL=
# AI_BASE_URL=

# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=

# Freebuff by default; set AI_PROVIDER=openai to use OpenAI itself.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Any other OpenAI-compatible service: AI_PROVIDER=custom needs AI_BASE_URL and
# AI_MODEL, plus AI_API_KEY when the service asks for one.
# AI_API_KEY=

# Ollama on this computer. No key needed.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2

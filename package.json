{
  "name": "studydeck",
  "version": "1.0.0",
  "private": true,
  "description": "A timetable, work and syllabus organiser for CBSE/NCERT students, run on your own computer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixels-ux/studydeck.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.server.config.ts",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}

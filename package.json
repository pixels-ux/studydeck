{
  "name": "studydeck",
  "version": "1.0.0",
  "private": true,
  "description": "A timetable, work and syllabus organiser for CBSE/NCERT students.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixels-ux/studydeck.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:node": "vite build --config vite.node.config.ts && vite build --config vite.node.config.ts --mode server",
    "start": "node dist/node/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@freebuff/auth": "0.1.0",
    "hono": "^4.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "miniflare": "5.20261110.0-beta",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  }
}

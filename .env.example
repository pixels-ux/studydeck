# Copy to .env and fill in what you need. Everything is optional locally.

# AI study desk: pick one provider (40 actions per student per day).
# With no AI_PROVIDER, the first key set wins: OpenRouter, Gemini, Freebuff.
# AI_PROVIDER=freebuff | openrouter | gemini | openai | ollama
# AI_MODEL=
# AI_BASE_URL=

# OpenRouter (https://openrouter.ai/keys). Default model openrouter/auto.
# OPENROUTER_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey). Default gemini-2.5-flash.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Freebuff by default (https://freebuff.com/account/api);
# set AI_PROVIDER=openai to use OpenAI's own key and endpoint instead.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Ollama on the machine running the server. No key needed.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2

# Sign in with Freebuff. Omit to get the loopback-only local preview identity.
# FREEBUFF_CLIENT_ID=
# FREEBUFF_ISSUER=
# APP_ORIGIN=https://your-origin.example

# Plain Node host only
# DATABASE_PATH=data/studydeck.db
# PORT=3000
# HOST=0.0.0.0
